MONGODB_URI=mongodb://localhost:27017/interview
PORT=3000
NODE_ENV=development

# 通义千问或 OpenAI-compatible API
AI_API_KEY=your_api_key_here
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=glm-5.2

# CORS 配置（生产环境必填）
ALLOWED_ORIGINS=http://localhost:5173,http://120.79.15.127

# 图片上传目录（可选；默认 monorepo 根 uploads/，Docker 用 /app/uploads）
# UPLOAD_DIR=uploads

# RAG / 聊天
DATABASE_URL=postgres://interview:interview@localhost:5432/interview
MILVUS_URI=http://localhost:19530
AI_EMBEDDING_MODEL=text-embedding-v3
# 启动时是否全量重建题库向量（默认 false；请在「知识库管理」页手动重建）
# RAG_STARTUP_REINDEX=true

# Auth (JWT access + opaque refresh hashed in MongoDB; no JWT_REFRESH_SECRET)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
